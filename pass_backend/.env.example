# Database Configuration (PostgreSQL)
# Primary: Connection URL (Recommended for Render)
DATABASE_URL="postgresql://user:password@hostname:port/db_name?schema=public"

# Fallback: Individual Variables (Used if DATABASE_URL is missing)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=pass_user
DATABASE_PASSWORD=pass_password
DATABASE_NAME=pass_db

# MinIO Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=pass-vehicles
MINIO_BUCKET_HELPDESK=helpdesk
MINIO_USE_SSL=false
